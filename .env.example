# =============================================================================
# Law Firm Management Platform - environment template
# Copy to .env and fill in. NEVER commit .env. Use different values per environment
# (development, acceptance, production). Real secrets are never stored in this file.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=fr
TZ=Africa/Douala
NEXT_TELEMETRY_DISABLED=1

# --- Database ----------------------------------------------------------------
# Never exposed outside the Docker network in production.
DATABASE_URL=postgresql://lawfirm:change-me@localhost:5432/lawfirm?schema=public

# --- Authentication (Better Auth) --------------------------------------------
# Generate a long random value, for example: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Roles that must enrol two-factor (comma separated role keys)
TWO_FACTOR_REQUIRED_ROLES=PARTNER,LEAD_LAWYER,ASSOCIATE_LAWYER,TECHNICAL_ADMIN,FUNCTIONAL_ADMIN,ACCOUNTANT

# --- File storage ------------------------------------------------------------
# local is the default and the primary provider.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_UPLOAD_MB=100
# Allowed upload types (comma separated MIME types), adjust with the firm
STORAGE_ALLOWED_MIME=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain

# Optional alternative provider. Leave empty unless approved in writing by the firm
# and an ExternalTransferApproval row exists.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# --- Antivirus ---------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Background jobs ---------------------------------------------------------
# pg-boss uses the same PostgreSQL database.
WORKER_CONCURRENCY=4

# --- Backups -----------------------------------------------------------------
BACKUP_REPOSITORY_PATH=./backups
# File that contains the encryption passphrase. Keep it outside the repository and
# keep a copy in a separate secure place held by the firm. Never store it in Drive.
BACKUP_PASSPHRASE_FILE=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12

# --- Google Drive sync (approved exception, OFF by default) -------------------
DRIVE_SYNC_ENABLED=false
# Dedicated firm-owned account with two-factor. Credentials file kept outside the repository.
DRIVE_CREDENTIALS_FILE=
DRIVE_REMOTE_FOLDER=

# --- AI module (OpenAI, approved exception, OFF by default) --------------------
AI_ENABLED=false
OPENAI_API_KEY=
# Set the model after the firm approves it. Do not hard-code a model in the code.
AI_MODEL=
AI_MAX_INPUT_CHARS=20000
# Matters with these confidentiality levels are never sent unless enabled per matter
AI_BLOCKED_CONFIDENTIALITY=RESTRICTED,STRICT

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
